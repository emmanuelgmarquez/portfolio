{%- comment -%}
  Atelier & Oak: "The Hearth Collection" launch email. CONCEPT PIECE for a fictional brand.
  Generic Liquid, rendered locally with liquidjs (scripts/build.mjs). Every variable has a default.

  Expected data:
    first_name            string, optional
    products              array, optional. Each: name, material, price, sale_price?, url?, image_url?, image_alt?
    collection_url, story_url, unsubscribe_url, preferences_url, view_online_url, company_address   optional
    asset_base            set by the build (absolute URL of the images folder)
{%- endcomment -%}
{%- assign cta_url = collection_url | default: "https://emmanuelgmarquez.com/work/atelier-oak-concept" -%}
{%- assign fallback_image = asset_base | append: "/product-fallback.png" -%}
<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="x-apple-disable-message-reformatting">
<meta name="format-detection" content="telephone=no, date=no, address=no, email=no, url=no">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title>The Hearth Collection has arrived | Atelier &amp; Oak</title>
<!--[if gte mso 9]>
<xml>
  <o:OfficeDocumentSettings>
    <o:AllowPNG/>
    <o:PixelsPerInch>96</o:PixelsPerInch>
  </o:OfficeDocumentSettings>
</xml>
<![endif]-->
<!--[if mso]>
<style>
  /* Outlook on Windows ignores web fonts and falls back to Times New Roman unless told otherwise. */
  .serif { font-family: Georgia, serif !important; }
  .sans, body, table, td, p, a, span, li { font-family: Arial, sans-serif !important; }
  h1.serif, h2.serif, h3.serif, p.serif, span.serif, a.serif { font-family: Georgia, serif !important; }
  table { border-collapse: collapse; }
</style>
<![endif]-->

<!-- 1. Rules that must stay in the head: font loading, client resets, media queries, dark mode. juice leaves this block alone. -->
<style data-embed>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500%3B600&display=swap');
  @font-face {
    font-family: 'Cormorant Garamond';
    font-style: normal;
    font-weight: 500;
    font-display: swap;
    src: url('https://fonts.gstatic.com/s/cormorantgaramond/v21/co3umX5slCNuHLi8bLeY9MK7whWMhyjypVO7abI26QOD_s06GnM.ttf') format('truetype');
  }
  @font-face {
    font-family: 'Cormorant Garamond';
    font-style: normal;
    font-weight: 600;
    font-display: swap;
    src: url('https://fonts.gstatic.com/s/cormorantgaramond/v21/co3umX5slCNuHLi8bLeY9MK7whWMhyjypVO7abI26QOD_iE9GnM.ttf') format('truetype');
  }

  :root { color-scheme: light dark; supported-color-schemes: light dark; }

  /* Client resets */
  html, body { margin: 0 !important; padding: 0 !important; width: 100% !important; }
  body, table, td, p, a, li { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
  table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
  img { -ms-interpolation-mode: bicubic; }
  a[x-apple-data-detectors] { color: inherit !important; text-decoration: none !important; font: inherit !important; }
  u + #body a { color: inherit; text-decoration: none; font: inherit; }
  #MessageViewBody a { color: inherit; text-decoration: none; font: inherit; }
  .btn:hover { background-color: #3A352E !important; }

  /* Small screens: enhancement only. The grid already stacks without this. */
  @media only screen and (max-width: 480px) {
    .col { max-width: 100% !important; }
    .col .product-img { width: 100% !important; height: auto !important; }
    .gutter { padding-left: 20px !important; padding-right: 20px !important; }
    .hero-cell { height: 420px !important; padding: 16px !important; }
    .h1 { font-size: 34px !important; line-height: 38px !important; }
    .story-img { width: 100% !important; height: auto !important; }
    .btn { display: block !important; }
  }

  /* Dark mode, Apple Mail / iOS Mail / Outlook for Mac */
  @media (prefers-color-scheme: dark) {
    .bg-page { background-color: #121110 !important; }
    .bg-card { background-color: #1C1B19 !important; }
    .bg-panel { background-color: #262421 !important; }
    .ink { color: #F2EEE7 !important; }
    .muted { color: #B9B2A7 !important; }
    .accent { color: #E0B37E !important; }
    .rule { border-color: #3A3733 !important; }
    .btn { background-color: #F2EEE7 !important; color: #1C1B19 !important; border-color: #F2EEE7 !important; }
    .btn:hover { background-color: #DDD6CB !important; }
    /* Container swap: hide the light build of the logo and hero card, reveal the dark build. */
    .swap-light { display: none !important; }
    .swap-dark { display: block !important; max-height: none !important; overflow: visible !important; }
  }

  /* Dark mode, Outlook.com and the Outlook apps: [data-ogsc] carries text colour, [data-ogsb] carries background. */
  [data-ogsb] .bg-page { background-color: #121110 !important; }
  [data-ogsb] .bg-card { background-color: #1C1B19 !important; }
  [data-ogsb] .bg-panel { background-color: #262421 !important; }
  [data-ogsc] .ink { color: #F2EEE7 !important; }
  [data-ogsc] .muted { color: #B9B2A7 !important; }
  [data-ogsc] .accent { color: #E0B37E !important; }
  [data-ogsc] .rule { border-color: #3A3733 !important; }
  [data-ogsc] .btn { color: #1C1B19 !important; border-color: #F2EEE7 !important; }
  [data-ogsb] .btn { background-color: #F2EEE7 !important; }
  [data-ogsc] .swap-light { display: none !important; }
  [data-ogsc] .swap-dark { display: block !important; max-height: none !important; overflow: visible !important; }
</style>

<!-- 2. Base styles. juice inlines these onto the elements and removes the block. -->
<style>
  body { margin: 0; padding: 0; width: 100%; background-color: #EDE8E0; }
  table { border-spacing: 0; border-collapse: collapse; }
  td { padding: 0; }
  img { border: 0; text-decoration: none; line-height: 100%; }
  .bg-page { background-color: #EDE8E0; }
  .bg-card { background-color: #FAF8F4; }
  .bg-panel { background-color: #E9E2D6; }
  .ink { color: #1F1D1A; }
  .muted { color: #5C564D; }
  .accent { color: #7A4E22; }
  .serif { font-family: 'Cormorant Garamond', Georgia, 'Times New Roman', serif; }
  .sans { font-family: Arial, Helvetica, sans-serif; }
  .gutter { padding-left: 36px; padding-right: 36px; }
  .eyebrow { margin: 0; font-size: 14px; line-height: 20px; mso-line-height-rule: exactly; font-weight: bold; letter-spacing: 2px; text-transform: uppercase; }
  .h1 { margin: 0; font-size: 40px; line-height: 44px; mso-line-height-rule: exactly; font-weight: 500; }
  .h2 { margin: 0; font-size: 30px; line-height: 36px; mso-line-height-rule: exactly; font-weight: 500; }
  .h3 { margin: 0; font-size: 22px; line-height: 28px; mso-line-height-rule: exactly; font-weight: 600; }
  .body { margin: 0; font-size: 16px; line-height: 26px; mso-line-height-rule: exactly; font-weight: normal; }
  .small { margin: 0; font-size: 14px; line-height: 22px; mso-line-height-rule: exactly; font-weight: normal; }
  .link { text-decoration: underline; }
  .btn { display: inline-block; background-color: #1F1D1A; color: #FAF8F4; border: 1px solid #1F1D1A; border-radius: 2px; padding: 16px 40px; font-size: 15px; line-height: 20px; mso-line-height-rule: exactly; font-weight: bold; letter-spacing: 1.5px; text-transform: uppercase; text-decoration: none; text-align: center; }
  .col { display: inline-block; width: 100%; max-width: 288px; vertical-align: top; }
  .rule { border-top: 1px solid #D9D2C5; font-size: 0; line-height: 0; }
</style>
</head>
<body id="body" class="bg-page" style="margin:0; padding:0; word-spacing:normal;">

<!-- Preheader: shown in the inbox list, hidden in the message -->
<div class="preheader" style="display:none; font-size:1px; line-height:1px; max-height:0; max-width:0; overflow:hidden; mso-hide:all; color:#EDE8E0;">Four new pieces in oak, walnut and bouclé, made for the long evenings ahead.&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;</div>

<table role="presentation" class="bg-page" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;">
<tr>
<td align="center" style="padding:0;">

<!--[if mso]>
<table role="presentation" width="600" align="center" cellpadding="0" cellspacing="0" border="0"><tr><td>
<![endif]-->
<div class="wrap" style="max-width:600px; margin:0 auto;">
<table role="presentation" class="bg-card" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;">

  <!-- ============ LOGO BAR ============ -->
  <tr>
    <td class="gutter" align="center" style="padding-top:28px; padding-bottom:24px;">
      <a href="{{ cta_url }}" style="text-decoration:none;">
        <img class="swap-light" src="{{ asset_base }}/logo-light.png" width="208" height="32" alt="Atelier &amp; Oak" style="display:block; width:208px; height:32px; border:0; margin:0 auto;">
        <!--[if !mso]><!-->
        <img class="swap-dark" src="{{ asset_base }}/logo-dark.png" width="208" height="32" alt="Atelier &amp; Oak" style="display:none; width:208px; height:32px; max-height:0; overflow:hidden; border:0; margin:0 auto; mso-hide:all;">
        <!--<![endif]-->
      </a>
    </td>
  </tr>

  <!-- ============ HERO: background photo, live-text card ============ -->
  <tr>
    <td class="hero-cell" background="{{ asset_base }}/hero-autumn-light.jpg" bgcolor="#2A2118" valign="bottom" height="480" style="height:480px; padding:24px; mso-padding-alt:0; background-color:#2A2118; background-image:url('{{ asset_base }}/hero-autumn-light.jpg'); background-position:center center; background-size:cover; background-repeat:no-repeat;">
      <!--[if mso]>
      <v:rect xmlns:v="urn:schemas-microsoft-com:vml" fill="true" stroke="false" style="width:600px; height:480px;">
      <v:fill type="frame" src="{{ asset_base }}/hero-autumn-light.jpg" color="#2A2118" />
      <v:textbox inset="0,0,0,0">
      <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0"><tr><td width="552" height="432" valign="bottom" style="padding:24px;">
      <table role="presentation" width="372" cellpadding="0" cellspacing="0" border="0"><tr><td>
      <![endif]-->

      <!-- Light card (default; the only one Outlook on Windows sees) -->
      <div class="swap-light" style="max-width:372px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;">
        <tr>
          <td bgcolor="#FAF8F4" style="background-color:#FAF8F4; padding:28px 28px 30px 28px;">
            <p class="eyebrow sans" style="color:#7A4E22;">Autumn 2026</p>
            <h1 class="h1 serif" style="color:#1F1D1A; margin-top:10px;">The Hearth Collection</h1>
            <p class="body sans" style="color:#1F1D1A; margin-top:12px;">Four new pieces for the season of staying in.</p>
          </td>
        </tr>
      </table>
      </div>

      <!--[if !mso]><!-->
      <!-- Dark card: hidden until dark mode swaps it in; never sent to Outlook on Windows -->
      <div class="swap-dark" style="display:none; max-width:372px; max-height:0; overflow:hidden; mso-hide:all;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;">
          <tr>
            <td bgcolor="#1C1B19" style="background-color:#1C1B19; padding:28px 28px 30px 28px;">
              <p class="eyebrow sans" style="color:#E0B37E;">Autumn 2026</p>
              <h1 class="h1 serif" style="color:#F2EEE7; margin-top:10px;">The Hearth Collection</h1>
              <p class="body sans" style="color:#F2EEE7; margin-top:12px;">Four new pieces for the season of staying in.</p>
            </td>
          </tr>
        </table>
      </div>
      <!--<![endif]-->

      <!--[if mso]>
      </td></tr></table>
      </td></tr></table>
      </v:textbox>
      </v:rect>
      <![endif]-->
    </td>
  </tr>

  <!-- ============ INTRO ============ -->
  <tr>
    <td id="intro" class="gutter" style="padding-top:44px; padding-bottom:12px;">
      <p class="body sans ink" style="font-weight:bold;">Hi {{ first_name | default: "there" }},</p>
      <p class="body sans ink" style="margin-top:14px;">The light is lower and the evenings are longer, so we made furniture for exactly that. The Hearth Collection is four pieces in oak, walnut, brass and bouclé, drawn in our studio and built to be used every day for a very long time.</p>
      <p class="body sans ink" style="margin-top:14px;">Each one is available to order from today.</p>
    </td>
  </tr>

{%- if products and products.size > 0 %}

  <!-- ============ PRODUCT GRID: Liquid loop, hybrid columns, MSO ghost table ============ -->
  <tr>
    <td class="gutter" style="padding-top:28px;">
      <h2 class="h2 serif ink">New this season</h2>
    </td>
  </tr>
  <tr>
    <td align="center" style="padding:12px 12px 8px 12px; font-size:0; text-align:center;">
      <!--[if mso]>
      <table role="presentation" width="576" cellpadding="0" cellspacing="0" border="0"><tr>
      <![endif]-->
{%- for product in products limit:4 %}
{%- assign product_url = product.url | default: cta_url %}
{%- assign product_name = product.name | default: "New arrival" %}
      <!--[if mso]><td width="288" valign="top"><![endif]-->
      <div class="col">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;">
          <tr>
            <td align="left" style="padding:12px; text-align:left;">
              <a href="{{ product_url }}" style="text-decoration:none;"><img class="product-img" src="{{ product.image_url | default: fallback_image }}" width="264" height="323" alt="{{ product.image_alt | default: product_name | escape }}" style="display:block; width:264px; height:323px; border:0;"></a>
              <h3 class="h3 serif ink" style="margin-top:16px;"><a class="serif ink" href="{{ product_url }}" style="text-decoration:none;">{{ product_name | escape }}</a></h3>
              <p class="small sans muted" style="margin-top:4px;">{{ product.material | default: "Made to order" | escape }}</p>
{%- if product.sale_price %}
              <p class="body sans" style="margin-top:6px;"><span class="accent" style="font-weight:bold;">Now {{ product.sale_price }}</span>&nbsp; <span class="muted" style="text-decoration:line-through;">Was {{ product.price | default: "" }}</span></p>
{%- else %}
              <p class="body sans ink" style="margin-top:6px; font-weight:bold;">{{ product.price | default: "Price on request" }}</p>
{%- endif %}
            </td>
          </tr>
        </table>
      </div>
      <!--[if mso]></td><![endif]-->
{%- assign row_end = forloop.index | modulo: 2 %}
{%- if row_end == 0 and forloop.last == false %}
      <!--[if mso]></tr><tr><![endif]-->
{%- endif %}
{%- endfor %}
      <!--[if mso]>
      </tr></table>
      <![endif]-->
    </td>
  </tr>
{%- endif %}

  <!-- ============ CTA: VML button for Outlook, HTML/CSS button for everyone else ============ -->
  <tr>
    <td class="gutter" align="center" style="padding-top:20px; padding-bottom:48px;">
      <!--[if mso]>
      <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="{{ cta_url }}" style="height:54px; v-text-anchor:middle; width:300px;" arcsize="4%" stroke="f" fillcolor="#1F1D1A">
        <w:anchorlock/>
        <center style="color:#FAF8F4; mso-color-alt:auto; font-family:Arial, sans-serif; font-size:15px; font-weight:bold; letter-spacing:1.5px;">EXPLORE THE COLLECTION</center>
      </v:roundrect>
      <![endif]-->
      <!--[if !mso]><!-->
      <a class="btn sans" href="{{ cta_url }}">Explore the collection</a>
      <!--<![endif]-->
    </td>
  </tr>

  <!-- ============ DESIGNER STORY ============ -->
  <tr>
    <td id="story" class="bg-panel" style="padding:0;">
      <img class="story-img" src="{{ asset_base }}/story-workshop.jpg" width="600" height="340" alt="A furniture maker marks a cut line on a length of pale timber with a pencil, wood shavings across the bench." style="display:block; width:100%; max-width:600px; height:auto; border:0;">
    </td>
  </tr>
  <tr>
    <td class="bg-panel gutter" style="padding-top:36px; padding-bottom:44px;">
      <p class="eyebrow sans accent">From the workshop</p>
      <h2 class="h2 serif ink" style="margin-top:10px;">Drawn by hand, then made by it</h2>
      <p class="body sans ink" style="margin-top:14px;">Every Hearth piece starts as a pencil line on a board. Lead designer Ines Halvard works at full scale on the bench, so a curve is judged by eye and by hand before it is ever cut.</p>
      <p class="body sans ink" style="margin-top:14px;">&ldquo;If a joint is honest, you never have to hide it,&rdquo; she says. So we don&rsquo;t.</p>
      <p class="body sans" style="margin-top:18px;"><a class="link accent sans" href="{{ story_url | default: cta_url }}" style="font-weight:bold;">Read the making of Hearth</a></p>
    </td>
  </tr>

  <!-- ============ FOOTER ============ -->
  <tr>
    <td class="bg-page gutter" align="center" style="padding-top:36px; padding-bottom:24px; text-align:center;">
      <p class="small sans muted">You are receiving this because you asked to hear about new collections from Atelier &amp; Oak.</p>
      <p class="small sans muted" style="margin-top:12px;">{{ company_address | default: "Atelier &amp; Oak, [Street address], [City, State ZIP]" }}</p>
      <p class="small sans muted" style="margin-top:12px;">
        <a class="link muted sans" href="{{ unsubscribe_url | default: cta_url }}">Unsubscribe</a>
        &nbsp;&nbsp;|&nbsp;&nbsp;
        <a class="link muted sans" href="{{ preferences_url | default: cta_url }}">Email preferences</a>
        &nbsp;&nbsp;|&nbsp;&nbsp;
        <a class="link muted sans" href="{{ view_online_url | default: 'https://emmanuelgmarquez.com/email-samples/atelier-oak/index.html' }}">View in browser</a>
      </p>
    </td>
  </tr>
  <tr>
    <td class="bg-page gutter" style="padding-top:0; padding-bottom:0;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;"><tr><td class="rule" height="1" style="height:1px;">&nbsp;</td></tr></table>
    </td>
  </tr>
  <tr>
    <td class="bg-page gutter" align="center" style="padding-top:20px; padding-bottom:40px; text-align:center;">
      <p class="small sans muted">Concept piece. Atelier &amp; Oak is a fictional brand; this email was designed and hand-coded by Emmanuel G. Marquez as a portfolio study.</p>
    </td>
  </tr>

</table>
</div>
<!--[if mso]>
</td></tr></table>
<![endif]-->

</td>
</tr>
</table>
</body>
</html>
